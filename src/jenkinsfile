pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                script {
                    // Ensure we are in the correct directory before running the build
                    dir('Desktop') {
                        sh 'chmod +x gradlew' // Make gradlew executable
                        sh './gradlew build'  // Run gradle build
                    }
                }
            }
        }
    }
}



